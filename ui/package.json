{
  "name": "anyps5-ui",
  "version": "1.1.3-preview.10",
  "type": "module",
  "description": "PlayStation 5 styled Launcher and Relinker Studio for AnyPS5",
  "author": "RamsMadeUI",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node18 --outfile=dist-electron/main.cjs --external:electron --external:electron-updater && esbuild electron/preload.ts --bundle --platform=node --target=node18 --outfile=dist-electron/preload.cjs --external:electron",
    "build:all": "npm run build && npm run build:electron",
    "electron": "npm run build:all && electron .",
    "dist": "npm run build:all && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.anyps5.studio",
    "productName": "AnyPS5 Studio",
    "copyright": "Copyright © 2026 RamsMadeUI",
    "directories": {
      "output": "dist-installer"
    },
    "publish": {
      "provider": "github",
      "owner": "Ramzyayman",
      "repo": "AnyPS5-Studio"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build",
        "to": "build",
        "filter": [
          "relinker",
          "relinker.exe"
        ]
      },
      {
        "from": "../libs",
        "to": "libs"
      },
      {
        "from": "../tools",
        "to": "tools"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Game",
      "artifactName": "AnyPS5-Studio-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "AnyPS5-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnyPS5 Studio",
      "uninstallDisplayName": "AnyPS5 Studio"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
